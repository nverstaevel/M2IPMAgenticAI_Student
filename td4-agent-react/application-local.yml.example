# Copier en application-local.yml (ignoré par Git).
# Lancer avec --spring.profiles.active=local        (Ollama)
#         ou --spring.profiles.active=lmstudio,local (LM Studio : le fichier local surcharge le modèle)
spring:
  ai:
    ollama:
      base-url: http://localhost:11434
      chat:
        model: qwen2.5:7b
        temperature: 0.3
    openai:
      base-url: http://localhost:1234/v1   # LM Studio ; pour une API hébergée : l'URL du fournisseur
      api-key: lm-studio                   # une vraie clé ne va JAMAIS dans Git
      chat:
        model: qwen2.5-7b-instruct
        temperature: 0.3
